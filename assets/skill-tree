    <line x1="270" y1="130" x2="330" y2="130"/>
    <line x1="330" y1="130" x2="330" y2="95"/>
    <line x1="330" y1="130" x2="330" y2="165"/>
    <line x1="330" y1="95" x2="410" y2="95"/>
    <line x1="330" y1="165" x2="410" y2="165"/>
    <!-- Tools branch -->
    <line x1="270" y1="230" x2="330" y2="230"/>
    <line x1="330" y1="230" x2="330" y2="200"/>
    <line x1="330" y1="230" x2="330" y2="260"/>
    <line x1="330" y1="200" x2="410" y2="200"/>
    <line x1="330" y1="260" x2="410" y2="260"/>
    <!-- Learning branch -->
    <line x1="270" y1="330" x2="330" y2="330"/>
    <line x1="330" y1="330" x2="330" y2="300"/>
    <line x1="330" y1="330" x2="330" y2="335"/>
    <line x1="330" y1="300" x2="410" y2="300"/>
    <line x1="330" y1="335" x2="410" y2="335"/>
  </g>

  <!-- ===== Root node ===== -->
  <g transform="translate(90, 100)">
    <circle r="26" fill="url(#nodeFill)" filter="url(#nodeGlow)"/>
    <text x="0" y="5" font-family="'Segoe UI', Arial, sans-serif" font-weight="700" font-size="12" fill="#0A0E1A" text-anchor="middle">DEV</text>
  </g>

  <!-- ===== Branch root nodes ===== -->
  <g transform="translate(230, 130)">
    <circle r="20" fill="#131826" stroke="#4FC3F7" stroke-width="2"/>
    <text x="0" y="4" font-family="'Segoe UI', Arial, sans-serif" font-weight="700" font-size="9" fill="#4FC3F7" text-anchor="middle">LANG</text>
  </g>
  <g transform="translate(230, 230)">
    <circle r="20" fill="#131826" stroke="#4FC3F7" stroke-width="2"/>
    <text x="0" y="4" font-family="'Segoe UI', Arial, sans-serif" font-weight="700" font-size="9" fill="#4FC3F7" text-anchor="middle">TOOLS</text>
  </g>
  <g transform="translate(230, 330)">
    <circle r="20" fill="#131826" stroke="#4FC3F7" stroke-width="2"/>
    <text x="0" y="4" font-family="'Segoe UI', Arial, sans-serif" font-weight="700" font-size="8" fill="#4FC3F7" text-anchor="middle">LEARN</text>
  </g>

  <!-- ===== Language leaf nodes ===== -->
  <g transform="translate(410, 95)">
    <rect x="-58" y="-16" width="116" height="32" rx="16" fill="#131826" stroke="#2196F3" stroke-width="1.5"/>
    <circle cx="-38" cy="0" r="4" fill="#4FC3F7"/>
    <text x="-24" y="5" font-family="'Segoe UI', Arial, sans-serif" font-weight="600" font-size="12" fill="#E8F4FD">C++</text>
