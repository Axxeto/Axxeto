  <g transform="translate(410, 300)">
    <rect x="-56" y="-16" width="112" height="32" rx="16" fill="#131826" stroke="#4FC3F7" stroke-width="1.5" stroke-dasharray="4 3"/>
    <circle cx="-36" cy="0" r="4" fill="#E8F4FD"/>
    <text x="-22" y="5" font-family="'Segoe UI', Arial, sans-serif" font-weight="600" font-size="12" fill="#E8F4FD">GTPS</text>
  </g>
  <g transform="translate(410, 335)">
    <rect x="-64" y="-16" width="128" height="32" rx="16" fill="#131826" stroke="#4FC3F7" stroke-width="1.5" stroke-dasharray="4 3"/>
    <circle cx="-44" cy="0" r="4" fill="#E8F4FD"/>
    <text x="-30" y="5" font-family="'Segoe UI', Arial, sans-serif" font-weight="600" font-size="12" fill="#E8F4FD">Security</text>
  </g>

  <!-- ===== Right side: focus callout ===== -->
  <g transform="translate(560, 90)">
    <rect x="0" y="0" width="220" height="270" rx="10" fill="#131826" stroke="#2196F3" stroke-width="1" opacity="0.8"/>
    <text x="18" y="30" font-family="'Segoe UI', Arial, sans-serif" font-weight="700" font-size="13" fill="#4FC3F7" letter-spacing="1">CURRENT FOCUS</text>
    <rect x="18" y="40" width="60" height="2" fill="#2196F3"/>

