    <circle cx="-44" cy="0" r="4" fill="#4FC3F7"/>
    <text x="-30" y="5" font-family="'Segoe UI', Arial, sans-serif" font-weight="600" font-size="12" fill="#E8F4FD">Node.js</text>
  </g>
  <g transform="translate(410, 260)">
    <rect x="-78" y="-16" width="156" height="32" rx="16" fill="#131826" stroke="#2196F3" stroke-width="1.5"/>
    <circle cx="-58" cy="0" r="4" fill="#4FC3F7"/>
    <text x="-44" y="5" font-family="'Segoe UI', Arial, sans-serif" font-weight="600" font-size="12" fill="#E8F4FD">Web Systems</text>
  </g>

