    <circle cx="30" cy="130" r="4" fill="#4FC3F7" filter="url(#nodeGlow)"/>
    <text x="44" y="134" font-family="'Segoe UI', Arial, sans-serif" font-size="13" fill="#E8F4FD">Backend with Node.js</text>

    <circle cx="30" cy="162" r="4" fill="#E8F4FD" opacity="0.6"/>
    <text x="44" y="166" font-family="'Segoe UI', Arial, sans-serif" font-size="13" fill="#E8F4FD" opacity="0.7">Exploring GTPS</text>

    <rect x="18" y="200" width="184" height="1" fill="#2196F3" opacity="0.3"/>
    <text x="18" y="230" font-family="'Segoe UI', Arial, sans-serif" font-style="italic" font-size="12" fill="#4FC3F7">"Build. Secure.</text>
    <text x="18" y="248" font-family="'Segoe UI', Arial, sans-serif" font-style="italic" font-size="12" fill="#4FC3F7">Improve."</text>
  </g>
</svg>
