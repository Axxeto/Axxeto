  <text x="40" y="42" font-family="'Segoe UI', Arial, sans-serif" font-weight="700" font-size="20" fill="#E8F4FD" letter-spacing="1">SKILL TREE</text>
  <rect x="40" y="52" width="90" height="3" fill="#2196F3"/>

  <!-- ===== Connector lines (drawn first, under nodes) ===== -->
  <g stroke="#2196F3" stroke-width="2" opacity="0.35">
    <!-- root to branch roots -->
    <line x1="90" y1="100" x2="90" y2="130"/>
    <line x1="90" y1="130" x2="230" y2="130"/>
    <line x1="90" y1="130" x2="230" y2="230"/>
    <line x1="90" y1="130" x2="230" y2="330"/>
